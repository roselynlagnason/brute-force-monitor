# Copy this file to ".env" and edit. Never commit .env.

# --- Admin sign-in ---
ADMIN_USER=admin
# Generate with: npm run hash-password -- "your new password"
ADMIN_PASS_HASH=
# (Only used if ADMIN_PASS_HASH is empty. The built-in default is insecure.)
# ADMIN_PASS=
ADMIN_IDLE_MIN=15

# --- Behind a reverse proxy / hosting platform (Render, Railway, nginx, Cloudflare)? ---
# Set to 1 so the real visitor IP is read from X-Forwarded-For. Leave 0 when not behind a proxy.
TRUST_PROXY=0

# --- Lockout rules (enforced on the server) ---
MAX_FAILS=5
LOCK_WINDOW_SEC=60

# --- Alerts: raised when one IP reaches this many failures in the window ---
ALERT_THRESHOLD=10
ALERT_WINDOW_MIN=5
# Fill any of these to get notified (all optional):
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Slack/Mattermost-compatible incoming webhook (also works with many email-forwarding services)
ALERT_WEBHOOK_URL=

# --- Storage ---
PORT=3001
# DATA_DIR=./data
